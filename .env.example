# ─────────────────────────────────────────────────────────────
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
#   cp .env.example .env.local
#
# TẤT CẢ biến ở đây đều được đọc lúc BUILD (repo dùng `output: 'export'`),
# nên phải set trước khi chạy `npm run build` — kể cả trên CI.
# ─────────────────────────────────────────────────────────────

# Domain canonical của site, KHÔNG có slash cuối.
# Dùng cho: sitemap.xml, robots.txt, feed.xml, canonical URL, Open Graph.
# Không set thì fallback về https://hoangvangioi.com (xem src/lib/shared.ts).
SITE_URL=https://hoangvangioi.com

# Google AdSense — chỉ điền PHẦN SỐ, code tự thêm prefix `ca-pub-`.
# Ví dụ ID đầy đủ là ca-pub-1234567890123456 thì điền 1234567890123456.
# Để trống => tắt hoàn toàn quảng cáo (không render <ins>, ads.txt trả về rỗng).
NEXT_PUBLIC_AD_CLIENT=
NEXT_PUBLIC_AD_SLOT=
