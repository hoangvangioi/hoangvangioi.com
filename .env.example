# Copy to .env.local, then fill in real values:  cp .env.example .env.local
#
# Every variable here is read at BUILD time (the site uses output: "export"),
# so it must be set before `npm run build`, including on CI.

# Canonical domain, no trailing slash. Used by sitemap.xml, robots.txt,
# feed.xml, canonical URLs and Open Graph. Falls back to
# https://hoangvangioi.com when unset (see src/lib/shared.ts).
SITE_URL=https://hoangvangioi.com

# Google AdSense. Enter only the digits of the publisher ID, without the
# ca-pub- prefix. Leave both empty when the site runs no ads.
NEXT_PUBLIC_AD_CLIENT=
NEXT_PUBLIC_AD_SLOT=